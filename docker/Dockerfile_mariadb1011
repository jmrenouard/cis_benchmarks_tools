FROM mariadb:10.11

# Define environment variables to avoid interactions during installation
ENV DEBIAN_FRONTEND=noninteractive \
  TERM=xterm \
  MARIADB_ROOT_PASSWORD=rootpass

# 🛠️ Installation of system utilities and SSH
RUN apt-get update && apt-get install -y --no-install-recommends \
  openssh-server \
  openssl \
  rsync \
  vim \
  nano \
  net-tools \
  procps \
  wget \
  curl \
  git \
  unzip \
  python3 \
  python3-pip \
  ca-certificates && \
  mkdir -p /var/run/sshd /exemples /datas && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# 🔐 SSH Configuration (root password - Use for DEV only)
RUN echo 'root:rootpass' | chpasswd && \
  sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config && \
  sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
  ssh-keygen -A

# ⚙️ MariaDB Configuration
# Create a .my.cnf for root to allow passwordless local connections
RUN echo "[client]\nuser=root\npassword=rootpass" > /root/.my.cnf && \
  chmod 600 /root/.my.cnf && \
  mkdir -p /var/lib/mysql-files && \
  chmod 750 /var/lib/mysql-files && \
  chown mysql:mysql /var/lib/mysql-files && \
  mkdir -p /etc/mysql/conf.d && \
  echo "[mariadbd]\nskip-symbolic-links=1\nsecure_file_priv=/var/lib/mysql-files\nsql_mode=STRICT_ALL_TABLES,NO_ENGINE_SUBSTITUTION\nlocal_infile=0" > /etc/mysql/conf.d/cis_hardened.cnf

# Exposed ports
EXPOSE 22 3306

# Volumes and Working Directory
VOLUME ["/datas"]
WORKDIR /datas

RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh

COPY id_rsa.pub /root/.ssh/authorized_keys
COPY id_rsa.pub /root/.ssh/id_rsa.pub
COPY id_rsa /root/.ssh/id_rsa

RUN chmod 600 /root/.ssh/authorized_keys /root/.ssh/id_rsa \
  && chown -R root:root /root/.ssh

# Copy the audit script for testing
COPY audit_cis_mariadb_1011.py /datas/audit_cis_mariadb_1011.py

# Startup: start SSH + MariaDB

# �� Startup Configuration using dedicated script
COPY scripts/start_mariadb.sh /usr/local/bin/start_mariadb.sh
RUN chmod +x /usr/local/bin/start_mariadb.sh

CMD ["/usr/local/bin/start_mariadb.sh"]
